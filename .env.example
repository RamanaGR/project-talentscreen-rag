# =============================================================================
# TalentScreen — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# ---------------------------------------------------------------------------
# APPLICATION
# ---------------------------------------------------------------------------
SECRET_KEY=change_this_to_a_secure_random_string_in_production
PROJECT_NAME=TalentScreen
VERSION=2.0.0

# ---------------------------------------------------------------------------
# LLM PROVIDER — Choose one. No code changes needed to switch providers.
#   Options: ollama | anthropic | openai | bedrock | g4f
#   - ollama    : local Ollama server, no API key required (recommended for development)
#   - anthropic : Claude 3.7 Sonnet via direct Anthropic API
#   - openai    : GPT-4 Turbo via OpenAI API
#   - bedrock   : Claude 3.7 Sonnet via AWS Bedrock
#   - g4f       : GPT4Free (free, no API key required)
# ---------------------------------------------------------------------------
LLM_PROVIDER=ollama

# ---------------------------------------------------------------------------
# LOCAL OLLAMA — Required only when LLM_PROVIDER=ollama
# ---------------------------------------------------------------------------
# Run "ollama serve" and "ollama pull llama3.2" before starting the backend.
# If the backend runs inside Docker while Ollama runs on Windows/macOS/Linux,
# use http://host.docker.internal:11434 instead of localhost.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=120

# ---------------------------------------------------------------------------
# API KEYS — Only the key matching LLM_PROVIDER is required.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here

# ---------------------------------------------------------------------------
# AWS BEDROCK — Required only when LLM_PROVIDER=bedrock
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-7-sonnet-20250219-v1:0

# ---------------------------------------------------------------------------
# DATABASE — PostgreSQL (audit logs, document registry, chat history)
# ---------------------------------------------------------------------------
# Local (non-Docker) development:
# DATABASE_URL=postgresql://user:pass@localhost:5432/talentscreen

# Docker Compose (automatically overridden in docker-compose.yml):
DATABASE_URL=postgresql://user:pass@postgres:5432/talentscreen

# ---------------------------------------------------------------------------
# CACHE — Redis (query result caching, session storage)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# VECTOR DATABASE — Milvus (HNSW semantic index)
# ---------------------------------------------------------------------------
MILVUS_HOST=milvus
MILVUS_PORT=19530
MILVUS_COLLECTION=talentscreen_docs

# ---------------------------------------------------------------------------
# EMBEDDINGS — SentenceTransformer model (runs locally, no API key needed)
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---------------------------------------------------------------------------
# RERANKER — BGE Cross-Encoder model (runs locally, no API key needed)
# ---------------------------------------------------------------------------
RERANKER_MODEL=BAAI/bge-reranker-base

# ---------------------------------------------------------------------------
# DOCUMENT STORAGE — S3 is the production path; falls back to local disk.
# ---------------------------------------------------------------------------
LOCAL_STORAGE_PATH=/app/data/resumes
S3_BUCKET=talentscreen-documents
S3_REGION=us-east-1
# Leave empty to use local storage only:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# OBSERVABILITY — Langfuse for LLM tracing (optional)
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
